#:set COLOR_PRIMARY (0.09, 0.11, 0.16, 1)
#:set COLOR_SURFACE (0.15, 0.18, 0.25, 0.92)
#:set COLOR_ACCENT (0.20, 0.76, 0.48, 1)
#:set COLOR_TEXT (0.95, 0.96, 0.98, 1)

<MenuScreen>:
    FloatLayout:
        Image:
            source: 'cover.png'
            size_hint: (1, 1)
            pos_hint: {'x': 0, 'y': 0}
            allow_stretch: True
            keep_ratio: False

        # Полупрозрачный слой поверх обложки для читаемости
        Widget:
            size_hint: (1, 1)
            pos_hint: {'x': 0, 'y': 0}
            canvas.before:
                Color:
                    rgba: (0.05, 0.07, 0.11, 0.45)
                Rectangle:
                    pos: self.pos
                    size: self.size

        BoxLayout:
            orientation: 'vertical'
            padding: [24, 36, 24, 36]
            spacing: 18
            size_hint: (1, 1)
            pos_hint: {'x': 0, 'y': 0}

            Label:
                text: 'KD CLICKER'
                font_size: '28sp'
                bold: True
                color: COLOR_TEXT
                size_hint_y: None
                height: '56dp'
                canvas.before:
                    Color:
                        rgba: COLOR_SURFACE
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14]

            Widget:
                size_hint_y: 1

            Button:
                text: 'Play'
                font_size: '22sp'
                bold: True
                size_hint: (0.8, None)
                height: '54dp'
                pos_hint: {'center_x': 0.5}
                background_normal: ''
                background_color: COLOR_ACCENT
                color: COLOR_PRIMARY
                on_press: root.go_to_game()

            Button:
                text: 'Settings'
                font_size: '18sp'
                bold: True
                size_hint: (0.7, None)
                height: '46dp'
                pos_hint: {'center_x': 0.5}
                background_normal: ''
                background_color: COLOR_SURFACE
                color: COLOR_TEXT
                on_press: root.go_to_settings()


<GameScreen>:
    canvas.before:
        Color:
            rgba: COLOR_PRIMARY
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [16, 20, 16, 20]
        spacing: 14

        # 1. HUD — верхняя панель со счётом и силой клика
        BoxLayout:
            id: hud_panel
            orientation: 'vertical'
            size_hint_y: None
            height: '116dp'
            padding: [12, 8]
            spacing: 2
            canvas.before:
                Color:
                    rgba: COLOR_SURFACE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]

            Label:
                text: 'SCORE'
                font_size: '14sp'
                bold: True
                color: COLOR_ACCENT
                size_hint_y: None
                height: '20dp'

            Label:
                id: clicks_label
                text: f'{root.score}'
                font_size: '28sp'
                bold: True
                color: COLOR_TEXT
                size_hint_y: None
                height: '40dp'

            Label:
                id: power_label
                text: f'Click Power: +{root.click_power} (Clicks: {root.clicks})'
                font_size: '15sp'
                bold: True
                color: COLOR_ACCENT
                size_hint_y: None
                height: '24dp'

        # 2. Game Area — центральная игровая область
        RelativeLayout:
            id: game_area
            size_hint_y: 1
            canvas.before:
                Color:
                    rgba: COLOR_SURFACE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18]

            Button:
                id: click_button
                size_hint: (0.65, 0.65)
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                background_normal: ''
                background_color: (0, 0, 0, 0)
                on_press: root.register_click()

                Image:
                    source: 'target.png'
                    size: click_button.size
                    pos: click_button.pos
                    allow_stretch: True
                    keep_ratio: True

        # 3. Control Panel — нижняя панель управления
        BoxLayout:
            id: control_panel
            orientation: 'horizontal'
            size_hint_y: None
            height: '52dp'
            padding: [10, 6]
            spacing: 10
            canvas.before:
                Color:
                    rgba: COLOR_SURFACE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]

            Button:
                text: 'Back'
                font_size: '18sp'
                bold: True
                background_normal: ''
                background_color: COLOR_ACCENT
                color: COLOR_PRIMARY
                on_press: root.go_to_menu()

            Button:
                text: 'Settings'
                font_size: '18sp'
                bold: True
                background_normal: ''
                background_color: COLOR_SURFACE
                color: COLOR_TEXT
                on_press: root.go_to_settings()


<SettingsScreen>:
    canvas.before:
        Color:
            rgba: COLOR_PRIMARY
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [20, 28, 20, 28]
        spacing: 16

        Label:
            text: 'SETTINGS'
            font_size: '24sp'
            bold: True
            color: COLOR_TEXT
            size_hint_y: None
            height: '48dp'

        BoxLayout:
            orientation: 'vertical'
            padding: [16, 16]
            spacing: 12
            size_hint_y: 1
            canvas.before:
                Color:
                    rgba: COLOR_SURFACE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16]

            Label:
                text: 'Volume'
                font_size: '18sp'
                color: COLOR_TEXT
                size_hint_y: None
                height: '30dp'

            Label:
                id: volume_value_label
                text: f'{int(volume_slider.value)}%'
                font_size: '22sp'
                bold: True
                color: COLOR_ACCENT
                size_hint_y: None
                height: '34dp'

            Slider:
                id: volume_slider
                min: 0
                max: 100
                step: 1
                value: root.volume
                size_hint_y: None
                height: '40dp'
                on_value: root.volume = self.value

            Button:
                text: 'Reset Clicks'
                font_size: '18sp'
                bold: True
                size_hint_y: None
                height: '46dp'
                background_normal: ''
                background_color: COLOR_ACCENT
                color: COLOR_PRIMARY
                on_press: app.root.get_screen('game').reset_clicks()

        Button:
            text: 'Back to Game'
            font_size: '18sp'
            bold: True
            size_hint_y: None
            height: '48dp'
            background_normal: ''
            background_color: COLOR_ACCENT
            color: COLOR_PRIMARY
            on_press: root.go_to_game()

        Button:
            text: 'Back to Menu'
            font_size: '18sp'
            bold: True
            size_hint_y: None
            height: '48dp'
            background_normal: ''
            background_color: COLOR_SURFACE
            color: COLOR_TEXT
            on_press: root.go_to_menu()