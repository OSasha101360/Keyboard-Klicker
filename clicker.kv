#:set COLOR_PRIMARY (0.09, 0.11, 0.16, 1)
#:set COLOR_SURFACE (0.15, 0.18, 0.25, 1)
#:set COLOR_ACCENT (0.20, 0.76, 0.48, 1)
#:set COLOR_TEXT (0.95, 0.96, 0.98, 1)

<MenuScreen>:
    canvas.before:
        Color:
            rgba: COLOR_PRIMARY
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [32, 48, 32, 48]
        spacing: 24

        BoxLayout:
            size_hint: (1, 0.16)
            pos_hint: {'center_x': 0.5}
            padding: [16, 10]
            canvas.before:
                Color:
                    rgba: COLOR_SURFACE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18]

            Label:
                text: 'KD CLICKER'
                font_size: '32sp'
                bold: True
                color: COLOR_TEXT

        BoxLayout:
            size_hint: (0.9, 0.44)
            pos_hint: {'center_x': 0.5}
            padding: [16, 16]
            canvas.before:
                Color:
                    rgba: COLOR_SURFACE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [22]

            Image:
                source: 'cover.png'
                allow_stretch: True
                keep_ratio: True

        Button:
            text: 'Play'
            font_size: '26sp'
            bold: True
            size_hint: (0.75, 0.16)
            pos_hint: {'center_x': 0.5}
            background_normal: ''
            background_color: COLOR_ACCENT
            color: COLOR_PRIMARY
            on_press: root.go_to_game()

        Button:
            text: 'Settings'
            font_size: '22sp'
            size_hint: (0.65, 0.13)
            pos_hint: {'center_x': 0.5}
            background_normal: ''
            background_color: COLOR_SURFACE
            color: COLOR_TEXT


<GameScreen>:
    canvas.before:
        Color:
            rgba: COLOR_PRIMARY
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [24, 28, 24, 28]
        spacing: 18

        # 1. HUD — верхняя информационная панель
        BoxLayout:
            id: hud_panel
            orientation: 'horizontal'
            size_hint: (1, 0.16)
            padding: [20, 12]
            canvas.before:
                Color:
                    rgba: COLOR_SURFACE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16]

            Label:
                text: 'SCORE'
                font_size: '20sp'
                bold: True
                color: COLOR_ACCENT
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Label:
                id: clicks_label
                text: f'{root.clicks}'
                font_size: '30sp'
                bold: True
                color: COLOR_TEXT
                halign: 'right'
                valign: 'middle'
                text_size: self.size

        # 2. Game Area — центральная игровая область
        RelativeLayout:
            id: game_area
            size_hint: (1, 0.64)
            canvas.before:
                Color:
                    rgba: COLOR_SURFACE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [24]

            Button:
                size_hint: (0.65, 0.65)
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                background_normal: ''
                background_color: (0, 0, 0, 0)
                on_press: root.register_click()

                Image:
                    source: 'target.png'
                    size_hint: (1, 1)
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    allow_stretch: True
                    keep_ratio: True

        # 3. Control Panel — нижняя панель управления
        BoxLayout:
            id: control_panel
            orientation: 'horizontal'
            size_hint: (1, 0.16)
            padding: [16, 12]
            spacing: 12
            canvas.before:
                Color:
                    rgba: COLOR_SURFACE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16]

            Button:
                text: 'Back to Menu'
                font_size: '20sp'
                bold: True
                size_hint: (1, 1)
                background_normal: ''
                background_color: COLOR_ACCENT
                color: COLOR_PRIMARY
                on_press: root.go_to_menu()